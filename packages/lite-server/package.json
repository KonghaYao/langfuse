{
  "name": "@langfuse/lite-server",
  "version": "0.1.0",
  "description": "Standalone lightweight Langfuse server (Lite mode, SQLite) - no Next.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "test": "vitest run",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "build": "tsc",
    "build:check": "tsc",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "dev": "dotenv -e ../../.env -- tsx watch --clear-screen=false --include '../shared/dist/*' src/index.ts",
    "lint": "eslint . --cache --cache-location dist/.eslintcache --max-warnings 0",
    "lint:fix": "eslint . --cache --cache-location dist/.eslintcache --fix"
  },
  "author": "engineering@langfuse.com",
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@langfuse/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "hono": "^4.12.27",
    "protobufjs": "7.6.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.2",
    "tsx": "^4.20.5",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
